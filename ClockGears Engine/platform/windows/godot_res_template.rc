#pragma code_page(65001)
#include "core/version.h"
#include "core/clockgears_version.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

GODOT_ICON ICON platform/windows/godot.ico
1 RT_MANIFEST "platform/windows/godot.manifest"

1 VERSIONINFO
FILEVERSION     CLOCKGEARS_VERSION_MAJOR,CLOCKGEARS_VERSION_MINOR,CLOCKGEARS_VERSION_PATCH,CLOCKGEARS_VERSION_BUILD
PRODUCTVERSION  CLOCKGEARS_VERSION_MAJOR,CLOCKGEARS_VERSION_MINOR,CLOCKGEARS_VERSION_PATCH,CLOCKGEARS_VERSION_BUILD
FILEOS          4
FILETYPE        1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",            CLOCKGEARS_COMPANY_NAME
            VALUE "FileDescription",        CLOCKGEARS_PRODUCT_NAME
            VALUE "FileVersion",            CLOCKGEARS_FILE_VERSION_STR
            VALUE "ProductName",            CLOCKGEARS_PRODUCT_NAME
            VALUE "LegalCopyright",         CLOCKGEARS_LEGAL_COPYRIGHT
            VALUE "ProductVersion",         CLOCKGEARS_FILE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
