            VALUE "LegalCopyright",         "(c) 2026 Kris'ZtS. All rights reserved."
            VALUE "Info",                   "https://clockgears.engine"
            VALUE "ProductVersion",         GODOT_VERSION_FULL_BUILD
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
