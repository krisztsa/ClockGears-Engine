        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",            "ClockGears Engine - Kris'ZtS"
            VALUE "FileDescription",        "ClockGears Engine (Console)"
            VALUE "FileVersion",            GODOT_VERSION_NUMBER
            VALUE "ProductName",            "ClockGears Engine (Console)"
